# Copy this file to .env and fill in real values. .env is gitignored;
# this file (.env.example) is safe to commit as documentation of what's needed.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True

# Comma-separated hostnames. Add your ngrok host here when testing webhooks/
# embedded signup — update it whenever the tunnel restarts.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=

EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

CELERY_BROKER_URL=redis://localhost:6379/0

# Meta / WhatsApp Embedded Signup
# https://developers.facebook.com/documentation/business-messaging/whatsapp/embedded-signup/implementation
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
META_GRAPH_API_VERSION=v26.0

# Must match the "Verify Token" field in the Meta App Dashboard's WhatsApp
# webhook configuration.
META_WEBHOOK_VERIFY_TOKEN=change-me
